{
  "expo": {
    "name": "Sort",
    "slug": "Sort",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "output": "single",
      "name": "Ball Sort",
      "shortName": "Ball Sort",
      "description": "Sort colored balls into tubes — a fun puzzle game",
      "themeColor": "#0F1923",
      "backgroundColor": "#0F1923",
      "display": "standalone",
      "orientation": "portrait"
    }
  }
}
